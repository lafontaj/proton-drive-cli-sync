msgstr ""
"    ⏱  Upload seit {m} Min. eingefroren (keine Aktivität) — Proton-CLI wird "
"beendet; dieser Ordner wird erneut versucht."

#, python-brace-format
msgid ""
"    ⛔ No write permission on {p} — ask the owner for access; skipping. ({e})"
msgstr ""
"    ⛔ Keine Schreibberechtigung für {p} — bitte den Eigentümer um Zugriff; "
"übersprungen. ({e})"

#, python-brace-format
msgid "    ⚠  Could not create {p}: {e}"
msgstr "    ⚠  {p} konnte nicht erstellt werden: {e}"

#, python-brace-format
msgid "    (nothing found at {p}: {e})"
msgstr "    (nichts gefunden bei {p}: {e})"

