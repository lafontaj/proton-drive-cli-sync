msgid "  🚫 excluded (folder): {p}"
msgstr "  🚫 ausgeschlossen (Ordner): {p}"

#, python-brace-format
msgid ""
"    ⚠  Could not list {p} — folder skipped this pass (nothing sent, nothing "
"deleted)."
msgstr ""
"    ⚠  {p} konnte nicht aufgelistet werden — Ordner in diesem Durchgang "
"übersprungen (nichts gesendet, nichts gelöscht)."

