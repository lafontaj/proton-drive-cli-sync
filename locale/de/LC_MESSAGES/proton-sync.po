msgid "    (same size but different content: {f})"
msgstr "    (gleiche Größe, aber anderer Inhalt: {f})"

msgid "upload frozen, stopped by the engine"
msgstr "Upload eingefroren, vom Modul beendet"

#, python-brace-format
msgid "    [DRY-RUN] would upload: {p}"
msgstr "    [DRY-RUN] würde hochladen: {p}"

#, python-brace-format
msgid ""
"    ⏭  {p} skipped this pass: the last {n} attempt(s) froze. It will be "
"tried again next pass."
msgstr ""
"    ⏭  {p} in diesem Durchgang übersprungen: Die letzten {n} Versuche sind "
"eingefroren. Es wird im nächsten Durchgang erneut versucht."

#, python-brace-format
msgid "    ✅ {n} file(s) sent to {p}"
msgstr "    ✅ {n} Datei(en) an {p} gesendet"

#, python-brace-format
