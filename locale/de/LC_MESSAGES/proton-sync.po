msgstr "Proton-CLI unbrauchbar"

#, python-brace-format
msgid ""
"This mappings file has {n} mapping(s) set to keep file revisions:\n"
"\n"
"{list}\n"
"\n"
"{why} These mappings will run in REPLACE mode: the previous version goes to "
