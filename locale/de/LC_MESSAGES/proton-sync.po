msgid "The suffix cannot be empty."
msgstr "Das Suffix darf nicht leer sein."

msgid "The suffix cannot contain / \\ \" '."
msgstr "Das Suffix darf nicht / \\ \" ' enthalten."

#, python-brace-format
msgid "[config] Data folder migrated: {old} -> {new}"
msgstr "[config] Datenordner migriert: {old} -> {new}"

#, python-brace-format
msgid ""
"[config] ⚠ Could not migrate the data folder ({e}) — using the legacy paths "
"for this run."
msgstr ""
"[config] ⚠ Datenordner konnte nicht migriert werden ({e}) — für diesen Lauf "
"werden die alten Pfade verwendet."

#, python-brace-format
msgid "[config] ⚠ Could not migrate the cache folder ({e})."
msgstr "[config] ⚠ Cache-Ordner konnte nicht migriert werden ({e})."

#, python-brace-format
msgid "    ✎ [DRY-RUN] would fix uppercase extension: {a} -> {b}"
msgstr ""
"    ✎ [DRY-RUN] würde Großbuchstaben-Erweiterung korrigieren: {a} -> {b}"

#, python-brace-format
msgid "    ✎ fixed uppercase extension: {a} -> {b}"
msgstr "    ✎ Großbuchstaben-Erweiterung korrigiert: {a} -> {b}"

#, python-brace-format
