msgid ""
"Reset finished (code {c}) — but some files failed; those folders will be "
"retried"
msgstr ""
"Zurücksetzen abgeschlossen (Code {c}) — aber einige Dateien sind "
"fehlgeschlagen; diese Ordner werden erneut versucht"

#, python-brace-format
msgid ""
"Priming finished (code {c}) — but some files failed; those folders will be "
