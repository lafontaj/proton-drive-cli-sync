msgstr ""
"    ⏭  {p} saltato in questo passaggio: gli ultimi {n} tentativi si sono "
"bloccati. Sarà ritentato al passaggio successivo."

#, python-brace-format
msgid "    ✅ {n} file(s) sent to {p}"
msgstr "    ✅ {n} file inviato/i a {p}"

