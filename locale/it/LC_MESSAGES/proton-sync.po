msgstr "    🚫 escluso (file): {p}"

#, python-brace-format
msgid "    ⚠  Could not list {p} — file skipped this pass."
msgstr "    ⚠  Impossibile elencare {p} — file saltato in questo passaggio."

#, python-brace-format
msgid "  ❌ Subpath not found or not a folder: {p}"
msgstr "  ❌ Sottopercorso non trovato o non è una cartella: {p}"

