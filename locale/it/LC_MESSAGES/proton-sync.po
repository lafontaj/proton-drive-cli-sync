msgid "{folder} — last pass {last} — next remote check {next}"
msgstr "{folder} — ultimo passaggio {last} — prossimo controllo remoto {next}"

msgid "Open"
msgstr "Apri"

msgid "Proton Drive Sync — synced"
msgstr "Proton Drive Sync — sincronizzato"

msgid "Proton Drive Sync — syncing"
msgstr "Proton Drive Sync — sincronizzazione in corso"

msgid "Proton Drive Sync — needs attention"
msgstr "Proton Drive Sync — richiede attenzione"
